# SafeSignal Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.

# Google Gemini API Configuration (Official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Security & CORS
FRONTEND_ORIGIN=http://localhost:5173

# Local Vector Storage & Retrieval
FAISS_INDEX_PATH=data/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Safe Demonstration Mode
# When true, SMS/Calls are accurately logged as Demo Mode without charging or misleading users
DEMO_MODE=true

# Real Cellular SMS Gateway Configuration (Optional)
# Option A: Fast2SMS (India)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Option B: Twilio (International & India)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
